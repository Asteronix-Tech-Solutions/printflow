# PintFlow System Environment Variables

# Backend Server Configuration
PORT=8080
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/pintflow?sslmode=disable
WEBHOOK_SECRET=08d637a8c722b3d9c24bafe90902f45c

# Printer Configuration (Brother DCP-T430W Wi-Fi printer)
DEFAULT_PRINTER=Brother_DCP_T430W
PRINTER_TYPE=ipp # Choices: ipp, cups, mock
PRINTER_ADDRESS=192.168.1.19

# Google Drive Integration
GOOGLE_CREDENTIALS_FILE=storage/credentials.json
GOOGLE_API_KEY=

# Storage Directory Paths
TEMP_DIR=storage/temp
ARCHIVE_DIR=storage/archive
LOG_DIR=storage/logs
MAX_CONCURRENT_JOBS=3

# Security & Authentication Configuration
API_KEY=pintflow_admin_secret_key_change_me
CORS_ALLOWED_ORIGINS=*

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_KEY=pintflow_admin_secret_key_change_me

# GitHub Container Registry (GHCR) Configuration
GH_OWNER=asteronix-tech-solutions

