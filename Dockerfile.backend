# Build stage
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Install ca-certificates and cups client libraries for CUPS support if needed
RUN apk add --no-cache git ca-certificates cups-client

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o pintflow-server ./cmd/server

# Final runtime stage
FROM alpine:3.19

WORKDIR /app

RUN apk add --no-cache ca-certificates cups-client netcat-openbsd tzdata sane-utils sane-backends py3-pip \
    && pip3 install --break-system-packages img2pdf 2>/dev/null || true

COPY --from=builder /app/pintflow-server .

EXPOSE 8080

CMD ["./pintflow-server"]
